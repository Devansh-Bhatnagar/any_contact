DATABASE_URL="postgresql://app_phone_number:change-me-db-password@localhost:5432/add_phone_number?schema=public"
# PORT is the internal port the Node process listens on (put a reverse proxy,
# e.g. nginx, in front of it terminating TLS for the public domain below).
PORT=5034
# Public production domain — used to build the absolute URLs returned by
# upload endpoints (e.g. https://api.addphonenumber.in/uploads/<file>).
# For local development, override with BASE_URL="http://localhost:5034".
BASE_URL="https://api.addphonenumber.in"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
UPLOAD_MAX_SIZE_MB=10
# Optional: absolute path override for where uploaded files are stored.
# Defaults to <project root>/uploads (server/uploads), always outside src/.
# UPLOAD_DIR="/var/www/add-phone-number/server/uploads"
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN="https://addphonenumber.in,https://www.addphonenumber.in,https://admin.addphonenumber.in"
